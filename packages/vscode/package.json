{
  "name": "shallgraph-vscode",
  "version": "0.11.0",
  "description": "Follow links in requirement files",
  "main": "dist/extension.js",
  "scripts": {
    "copy-wasm": "mkdir -p dist && cp ../core/wasm/shallgraph_wasm_bg.wasm dist/",
    "build": "npm run build -w @shallgraph/core && npm run copy-wasm && esbuild src/extension.ts --bundle --outfile=dist/extension.js --platform=node --format=cjs --external:vscode --sourcemap",
    "clean": "rm -rf dist",
    "package": "npm run copy-wasm && npx vsce package --no-dependencies",
    "publish-marketplace": "npx vsce publish --no-dependencies --skip-duplicate",
    "publish-openvsx": "npx ovsx publish --skip-duplicate"
  },
  "displayName": "ShallGraph",
  "publisher": "shallgraph",
  "repository": {
    "type": "git",
    "url": "https://github.com/jemoster/shallgraph.git"
  },
  "homepage": "https://github.com/jemoster/shallgraph",
  "bugs": {
    "url": "https://github.com/jemoster/shallgraph/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:yaml",
    "onCustomEditor:shallgraph.requirementRendered",
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "requirements",
    "yaml",
    "shallgraph"
  ],
  "license": "MIT",
  "dependencies": {
    "@shallgraph/core": "0.11.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "ovsx": "^1.2.0",
    "typescript": "^5.7.2"
  },
  "contributes": {
    "configurationDefaults": {
      "files.associations": {
        "*.req.yml": "yaml",
        "*.req.yaml": "yaml"
      }
    },
    "customEditors": [
      {
        "viewType": "shallgraph.requirementRendered",
        "displayName": "ShallGraph Rendered Requirement",
        "selector": [
          {
            "filenamePattern": "*.req.yml"
          },
          {
            "filenamePattern": "*.req.yaml"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "shallgraph.requirement.showRendered",
        "title": "ShallGraph: Show Rendered View",
        "category": "ShallGraph",
        "icon": "$(open-preview)"
      },
      {
        "command": "shallgraph.requirement.showSource",
        "title": "ShallGraph: Show YAML Source",
        "category": "ShallGraph",
        "icon": "$(file-code)"
      },
      {
        "command": "shallgraph.requirement.new",
        "title": "ShallGraph: Add New Requirement",
        "category": "ShallGraph"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "shallgraph.requirement.showRendered",
          "group": "navigation@1",
          "when": "editorLangId == yaml && resourceFilename =~ /\\.req\\.(yaml|yml)$/ && activeCustomEditorId != 'shallgraph.requirementRendered'"
        },
        {
          "command": "shallgraph.requirement.showSource",
          "group": "navigation@1",
          "when": "activeCustomEditorId == 'shallgraph.requirementRendered'"
        }
      ],
      "explorer/context": [
        {
          "command": "shallgraph.requirement.new",
          "group": "ShallGraph"
        }
      ]
    }
  }
}
