{
  "name": "@shallgraph/core",
  "version": "0.9.0",
  "description": "JS facade over shallgraph-core WASM — parse, validate, format, and HTML",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": {
    "./dist/wasm.js": "./dist/wasm.browser.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "require": "./dist-cjs/index.js",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "browser": "./dist/html.js",
      "require": "./dist-cjs/html.js",
      "node": "./dist/html.js",
      "import": "./dist/html.js",
      "default": "./dist/html.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "require": "./dist-cjs/types.js",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "browser": "./dist/engine.js",
      "require": "./dist-cjs/engine.js",
      "node": "./dist/engine.js",
      "import": "./dist/engine.js",
      "default": "./dist/engine.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "browser": "./dist/wasm.browser.js",
      "require": "./dist-cjs/wasm.js",
      "node": "./dist/wasm.js",
      "default": "./dist/wasm.js"
    }
  },
  "scripts": {
    "build": "bash ../../scripts/build-wasm-core.sh && rm -rf dist dist-cjs && tsc && tsc -p tsconfig.cjs.json && printf '{ \"type\": \"commonjs\" }\\n' > dist-cjs/package.json && mkdir -p dist/wasm dist/wasm-web dist-cjs/wasm dist-cjs/wasm-web && cp wasm/shallgraph_wasm.js wasm/shallgraph_wasm_bg.wasm wasm/package.json dist/wasm/ && cp wasm-web/shallgraph_wasm.js wasm-web/shallgraph_wasm_bg.wasm dist/wasm-web/ && cp wasm/shallgraph_wasm.js wasm/shallgraph_wasm_bg.wasm wasm/package.json dist-cjs/wasm/ && cp wasm-web/shallgraph_wasm.js wasm-web/shallgraph_wasm_bg.wasm dist-cjs/wasm-web/",
    "clean": "rm -rf dist dist-cjs wasm wasm-web"
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "keywords": [
    "requirements",
    "yaml"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
