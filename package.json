{
  "name": "shallgraph",
  "private": true,
  "description": "Requirement management tool",
  "type": "module",
  "scripts": {
    "build": "bash ./scripts/build-wasm-core.sh && npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "validate": "cargo run -p shallgraph -- validate",
    "format": "cargo run -p shallgraph -- format",
    "html": "cargo run -p shallgraph -- html",
    "markdown": "cargo run -p shallgraph -- markdown",
    "bootstrap": "cargo run -p shallgraph -- bootstrap",
    "test": "jest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:all": "npm test && cargo test --workspace && npm run test:visual"
  },
  "workspaces": [
    "packages/core",
    "packages/vscode"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "@playwright/test": "^1.56.1"
  },
  "overrides": {
    "dompurify": "3.3.3",
    "brace-expansion": "5.0.12"
  }
}
